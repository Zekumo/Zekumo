# MiniCloud 配置示例。复制成 .env 后按需修改;.env 已被 .gitignore 忽略。
#
#   cp .env.example .env
#   # 生成密钥:openssl rand -hex 32
#   docker compose --env-file .env up -d
#
# 标注「生产必改」的项在 MINICLOUD_ENV=production 下未修改会直接拒绝启动。

# ---- 运行模式 ----------------------------------------------------------
# production 会把不安全的配置从警告升级为启动失败。
MINICLOUD_ENV=production

# ---- 必改项 ------------------------------------------------------------
# 令牌签名密钥。用默认值等于任何人都能伪造令牌。openssl rand -hex 32
JWT_SECRET=
# 控制台管理员。用默认密码等于控制台对所有人开放。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 对外可访问的基础 URL(含协议和域名,不要以 / 结尾)。
# 本地存储驱动用它生成产物的上传/下载链接,填 localhost 客户端会下载不到。
BASE_URL=https://api.example.com

# ---- 依赖 --------------------------------------------------------------
DATABASE_URL=postgres://minicloud:CHANGE_ME@postgres:5432/minicloud
REDIS_ADDR=redis:6379

# ---- 网络 --------------------------------------------------------------
MINICLOUD_ADDR=:8080
# 部署在 Nginx / CDN 之后时必须开启,否则所有请求的来源 IP 都是反代的 IP,
# 按 IP 限流会把全部流量算作同一个来源。反代必须覆写 X-Forwarded-For。
TRUST_PROXY=true

# ---- 产物存储 ----------------------------------------------------------
# local:本进程用磁盘提供签名上传/下载,适合单机。
# s3:  S3 / MinIO / R2 / OSS,多实例部署必须用这个。
STORAGE_DRIVER=local
LOCAL_DATA_DIR=/data
MAX_ARTIFACT_SIZE=2147483648
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_USE_SSL=true

# ---- 行为 --------------------------------------------------------------
TOKEN_TTL=168h
# 统计日界时区。写入与查询共用它,改动后历史数据的分日归属会变。
STATS_TZ=Asia/Shanghai
LOG_RETENTION_DAYS=14
# true 会记录每个 API 请求;默认只记 4xx/5xx 和超过 1 秒的慢请求。
LOG_HTTP_ALL=false
# 聊天敏感词表,一行一个词。留空则不过滤。
# BANNED_WORDS_FILE=/etc/minicloud/banned_words.txt

# ---- 仅本地开发 --------------------------------------------------------
# 允许云函数与 WebHook 访问内网地址。生产开启等于把内网暴露给租户脚本,
# production 模式下会拒绝启动。
FUNC_HTTP_ALLOW_PRIVATE=false
